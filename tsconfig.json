{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["pages/*"],
      "@utils/*": ["utils/*"],
      "@constants/*": ["constants/*"],
      "@fixtures/*": ["fixtures/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "utils/**/*.ts",
    "constants/**/*.ts",
    "database/**/*.ts",
    "test-data/**/*.ts",
    "reporting/**/*.ts",
    "browserstack.config.ts",
    "browserstack.global-setup.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "test-results", "playwright-report"]
}
