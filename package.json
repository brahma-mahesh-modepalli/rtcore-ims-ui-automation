{
  "name": "playwright-framework",
  "version": "1.0.0",
  "description": "Production-ready Playwright + TypeScript E2E automation framework using Page Object Model",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:qa": "cross-env ENVIRONMENT=qa npx playwright test",
    "test:prod": "cross-env ENVIRONMENT=prod npx playwright test",
    "test:login": "npx playwright test tests/login.spec.ts",
    "test:login:prod": "cross-env ENVIRONMENT=prod npx playwright test tests/login.spec.ts",
    "test:login:qa": "cross-env ENVIRONMENT=qa npx playwright test tests/login.spec.ts",
    "report": "npx playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.11.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "e2e",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pg": "^8.11.0"
  }
}
