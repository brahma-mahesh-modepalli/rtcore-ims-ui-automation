# PostgreSQL connection settings (Stage environment)
# Copy this file to .env and fill in real values locally. Never commit .env.
DB_HOST=your-stage-db-host
DB_PORT=5432
DB_NAME=whataburger_ims
DB_USER=your-stage-db-username
DB_PASSWORD=your-stage-db-password
# Set to false only for local Postgres instances that don't use TLS
DB_SSL=true

# BrowserStack Automate credentials and metadata
BROWSERSTACK_USERNAME=your-browserstack-username
BROWSERSTACK_ACCESS_KEY=your-browserstack-access-key
BROWSERSTACK_PROJECT_NAME=RTCore IMS UI Automation
BROWSERSTACK_BUILD_NAME=rtcore-ims-ui-automation - feature/inventory-tests
# Keep true when BrowserStack must reach private/internal QA URLs.
BROWSERSTACK_LOCAL=true
BROWSERSTACK_LOCAL_IDENTIFIER=rtcore-ims-ui-automation-local
