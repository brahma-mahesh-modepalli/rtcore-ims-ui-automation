  {
  "testCaseId": "TC_RCSP-206_03",
  "testName": "Verify Assign Item popup elements and button state",
  "description": "Verify user can open the Assign Item popup from an existing Count Location and validate all popup elements along with the Assign and Cancel button states.",

  "testSteps": [
    {
      "step": 1,
      "description": "Launch application",
      "expectedResult": "Dashboard is displayed"
    },
    {
      "step": 2,
      "description": "Login with valid credentials",
      "expectedResult": "User logged in successfully"
    },
    {
      "step": 3,
      "description": "Verify STOCK COUNT menu",
      "expectedResult": "STOCK COUNT menu is visible"
    },
    {
      "step": 4,
      "description": "Expand STOCK COUNT menu",
      "expectedResult": "Submenus are displayed"
    },
    {
      "step": 5,
      "description": "Click Count Locations",
      "expectedResult": "Count Locations page is displayed"
    },
    {
      "step": 6,
      "description": "Click on the 'Walk-In Cooler' location row",
      "expectedResult": "Location row is selected"
    },
    {
      "step": 7,
      "description": "Expand the 'Walk-In Cooler' location row",
      "expectedResult": "Location details section is expanded"
    },
    {
      "step": 8,
      "description": "Verify '+ ASSIGN ITEM' button is visible",
      "expectedResult": "'+ ASSIGN ITEM' button is displayed and enabled"
    },
    {
      "step": 9,
      "description": "Click '+ ASSIGN ITEM' button",
      "expectedResult": "'Assign Item To Location' popup is displayed"
    },
    {
      "step": 10,
      "description": "Verify all popup elements",
      "expectedResult": "Popup title, Item search textbox, Daily, Weekly, Monthly options, Assign button, Cancel button and Close button are displayed"
    },
    {
      "step": 11,
      "description": "Verify Assign and Cancel button states without entering mandatory fields",
      "expectedResult": "Assign button is disabled and Cancel button is enabled"
    }
  ],

  "testData": {
    "navigationItems": [
      "Count Locations"
    ],
    "assignItemPopupItems": [
      {
        "locationName": "Walk-In Cooler",
         "itemName": "1000002"
      }
    ]
  }
},{
  "testCaseId": "TC_RCSP-206_04",
