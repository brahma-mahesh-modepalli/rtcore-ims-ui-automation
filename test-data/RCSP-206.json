            "expectedResult": "Submenus are displayed"
          },
          {
            "step": 5,
            "description": "Click Count Locations",
            "expectedResult": "Count Locations page is displayed"
          }
        ],
        "testData": {
          "navigationItems": [
            "Count Locations"
          ]
        }
  },
  {
        "testCaseId": "TC_RCSP-206_02",
        "testName": "Verify user can create a new Count Location",
        "description": "Verify user can create a new Count Location using mandatory fields.",

        "testSteps": [
