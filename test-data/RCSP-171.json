        },
        "PM": {
          "start": "22:00",
          "end": "24:00"
        }
      }
    },
    "testCases": [
      {
        "testCaseId": "TC_RCSP-171_01",
        "testName": "Verify Spot Count and Daily Count removed; Daily Shift Count unified menu present",
        "testType": "Positive",
        "testData": {
          "action": "verifyUnifiedMenu",
          "forbiddenMenus": [
            "Spot Count",
            "Daily Count"
          ],
          "requiredMenus": [
            "Daily Shift Count",
            "Weekly Count",
            "Monthly Count"
          ]
        }
      },
      {
        "testCaseId": "TC_RCSP-171_02",
        "testName": "Create Daily Shift Count with AM shift",
        "testType": "Positive",
        "testData": {
          "action": "createShiftSession",
          "shift": "AM",
          "expectedHeaderFragment": "AM"
        }
      },
      {
        "testCaseId": "TC_RCSP-171_03",
        "testName": "Create Daily Shift Count with Mid shift",
        "testType": "Positive",
        "testData": {
          "action": "createShiftSession",
          "shift": "Mid",
