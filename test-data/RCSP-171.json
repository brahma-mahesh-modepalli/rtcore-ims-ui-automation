{
  "RCSP-171": {
    "scenarioId": "RCSP-171",
    "epic": "EPIC-RCSP-119",
    "feature": "Stock Count \u2013 Unified Daily Shift Count",
    "sourceSheet": "Sheet1",
    "description": "Verify Spot/Daily Count menu consolidation into Daily Shift Count with AM/Mid/PM shifts, windows, pre-load, and add-item rules.",
    "commonData": {
      "prerequisites": [
        "QA Backoffice is accessible",
        "Admin credentials are valid",
        "Store hierarchy is configured"
      ],
      "userRole": "admin",
      "hierarchy": {
        "region": "1700 San Antonio 4126314",
        "market": "1708 E Central SA 4126393",
        "store": "WB Unit 1034"
      },
      "createCount": {
        "shiftDate": "2026-07-19",
        "namePrefix": "RCSP-171"
      },
      "allowedShifts": [
        "AM",
        "Mid",
        "PM"
      ],
      "forbiddenShifts": [
        "Opening",
        "Mid-Shift",
        "Closing"
      ],
      "forbiddenMenus": [
        "Spot Count",
        "Daily Count"
      ],
      "requiredMenus": [
        "Daily Shift Count",
        "Weekly Count",
        "Monthly Count"
      ],
      "activeItem": {
        "name": "LARGE BUNS",
        "plu": "11201"
      },
      "inactiveItem": {
